# 生产部署前必须修改以下值，并将实际 .env 留在服务器，不提交到 Git。
DB_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# 可选企业集成
INTAKE_ENABLED=false
INTAKE_TOKEN=replace-with-random-intake-token
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
WECHAT_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SSO_ENABLED=false
